{
  "manifest_version": 3,
  "name": "Arcadia Armory",
  "version": "1.4.1",
  "description": "Importiert deine Items (Control Panel oder eingefügte Liste) in den Arcadia Online Calculator, filtert die Ausrüstungsauswahl auf deine Items und zeigt die Schadensänderung direkt in der Auswahl.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arcadia-armory@moonmancer.local",
      "update_url": "https://raw.githubusercontent.com/Moonmancer/arcadia-armory/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://calc.arcadia-online.org/*",
    "https://cp.arcadia-online.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://calc.arcadia-online.org/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://calc.arcadia-online.org/*"
      ],
      "js": [
        "src/woe-blacklist.js",
        "src/headgear-slots.js",
        "src/page.js"
      ],
      "css": [
        "src/panel.css",
        "src/theme-armory.css"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cp.arcadia-online.org/masteraccount/items/*"
      ],
      "js": [
        "src/cp.js"
      ],
      "css": [
        "src/cp.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
